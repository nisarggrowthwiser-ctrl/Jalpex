# ── JALPEX INTERNATIONAL APACHE CONFIGURATION (.htaccess) ──

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── 301 REDIRECTS: Old .html URLs → Clean extensionless URLs ──
  # Preserves SEO and avoids duplicate content
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+gallery\.html [NC]
  RewriteRule ^ /gallery [R=301,L]

  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+news\.html [NC]
  RewriteRule ^ /news [R=301,L]

  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+catalog\.html [NC]
  RewriteRule ^ /catalog [R=301,L]

  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+product\.html [NC]
  RewriteRule ^ /product [R=301,L]

  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+faq\.html [NC]
  RewriteRule ^ /faq [R=301,L]

  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+legal\.html [NC]
  RewriteRule ^ /legal [R=301,L]

  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.html [NC]
  RewriteRule ^ / [R=301,L]

  # ── CLEAN URL REWRITES: Serve .html files internally ──
  # Requests for /gallery → serve gallery.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^\.]+)$ $1.html [NC,L]

</IfModule>

# MIME Types
<IfModule mod_mime.c>
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType application/json .json
</IfModule>

# Gzip Compression for Fast Page Loads
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Browser Caching Policy
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Custom Error Pages
ErrorDocument 404 /index.html
