# ── JALPEX INTERNATIONAL APACHE CONFIGURATION (.htaccess) ──

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── 301 REDIRECTS: Force clean extensionless URLs (Strip .html) ──
  # 1. Redirect index.html -> /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.html [NC]
  RewriteRule ^ / [R=301,L]

  # 2. Redirect /gallery/ -> /gallery (remove trailing slash)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+gallery/\s [NC]
  RewriteRule ^ /gallery [R=301,L]

  # 3. Redirect any *.html -> clean URL (e.g. /news.html -> /news, /faq.html -> /faq)
  RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # ── SECTION CLEAN URLS: Serve index.html / gallery.html internally ──
  RewriteRule ^gallery$ gallery.html [NC,L]
  RewriteRule ^products$ index.html [NC,L]
  RewriteRule ^why-us$ index.html [NC,L]
  RewriteRule ^inquiry$ index.html [NC,L]
  RewriteRule ^home$ index.html [NC,L]

  # ── CLEAN URL REWRITES: Serve .html files internally ──
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^\.]+)$ $1.html [NC,L]

</IfModule>

# MIME Types
<IfModule mod_mime.c>
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType application/json .json
</IfModule>

# Gzip Compression for Fast Page Loads
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Browser Caching Policy
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Custom Error Pages
ErrorDocument 404 /index.html
